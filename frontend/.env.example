# Public contract addresses only. Never place private keys, seed phrases, or API secrets here.
# Replace each placeholder with the address produced by your own Hardhat deployment.

# Hardhat local network (chain ID 31337)
VITE_HARDHAT_RPC_URL=http://127.0.0.1:8545
VITE_HARDHAT_CFD_TOKEN_ADDRESS=0xYOUR_HARDHAT_CFD_TOKEN_ADDRESS
VITE_HARDHAT_CROWDFUNDING_ADDRESS=0xYOUR_HARDHAT_CROWDFUNDING_ADDRESS
VITE_HARDHAT_CFD_GOVERNANCE_ADDRESS=0xYOUR_HARDHAT_CFD_GOVERNANCE_ADDRESS

# Public gateway used only to read campaign metadata and images.
VITE_IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Public SIWE scope. It must exactly mirror the server allowlist.
VITE_SIWE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_SIWE_CHAIN_ID=31337

# Sepolia test network (chain ID 11155111)
VITE_SEPOLIA_CFD_TOKEN_ADDRESS=0xYOUR_SEPOLIA_CFD_TOKEN_ADDRESS
VITE_SEPOLIA_CROWDFUNDING_ADDRESS=0xYOUR_SEPOLIA_CROWDFUNDING_ADDRESS
VITE_SEPOLIA_CFD_GOVERNANCE_ADDRESS=0xYOUR_SEPOLIA_CFD_GOVERNANCE_ADDRESS
