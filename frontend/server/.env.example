# Server-only secret. Never prefix this variable with VITE_ and never commit server/.env.
PINATA_JWT=replace_with_a_restricted_pinata_jwt

# Fundora API configuration. Origins must not include paths or trailing slashes.
NODE_ENV=development
FUNDORA_API_HOST=127.0.0.1
FUNDORA_API_PORT=8787
FUNDORA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FUNDORA_TRUST_PROXY=false

# Strict SIWE scope for the future authentication endpoints.
SIWE_ALLOWED_DOMAINS=localhost:5173,127.0.0.1:5173
SIWE_ALLOWED_URIS=http://localhost:5173,http://127.0.0.1:5173
SIWE_CHAIN_ID=31337
SIWE_NONCE_COOKIE_NAME=fundora_siwe_attempt
SIWE_NONCE_TTL_SECONDS=300
SIWE_NONCE_MAX_ACTIVE=1000
SIWE_NONCE_RATE_LIMIT=10
SIWE_NONCE_RATE_WINDOW_SECONDS=300
SIWE_VERIFY_RATE_LIMIT=10
SIWE_VERIFY_RATE_WINDOW_SECONDS=300
SIWE_MESSAGE_MAX_AGE_SECONDS=300
SIWE_CLOCK_SKEW_SECONDS=60

# Future server-side session policy. No session secret belongs in this template.
SESSION_COOKIE_NAME=fundora_session_dev
CSRF_COOKIE_NAME=fundora_csrf_dev
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=strict
SESSION_IDLE_TTL_SECONDS=900
SESSION_ABSOLUTE_TTL_SECONDS=3600
SESSION_MAX_ACTIVE=1000
SESSION_RATE_LIMIT=120
SESSION_RATE_WINDOW_SECONDS=900

# Legacy names remain accepted so existing local server/.env files keep working.
IPFS_PROXY_PORT=8787
IPFS_PROXY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development uses an in-memory nonce store. A production deployment with more
# than one API instance must use shared nonce and session stores supporting
# atomic consume/delete, centralized expiry, revocation, and rate limiting.
# Production must also use HTTPS, Secure cookies, and __Host-fundora_session.
